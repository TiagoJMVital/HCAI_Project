{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateFeaturesV2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "critic_score": {"type": "number", "minimum": 1, "maximum": 5},
    "change_count": {"type": "integer", "minimum": 1},
    "change_type": {"enum": ["add", "move", "delete", "mixed"]},
    "max_touched_importance": {"type": "integer", "minimum": 1, "maximum": 5},
    "touches_fixed": {"type": "boolean"},
    "touches_third_party": {"type": "boolean"},
    "deletes_event": {"type": "boolean"},
    "moves_event": {"type": "boolean"},
    "adds_event": {"type": "boolean"}
  },
  "required": [
    "critic_score",
    "change_count",
    "change_type",
    "max_touched_importance",
    "touches_fixed",
    "touches_third_party",
    "deletes_event",
    "moves_event",
    "adds_event"
  ]
}
