LLM_PROVIDER=iaedu
IAEDU_API_KEY=
IAEDU_API_ENDPOINT=
IAEDU_CHANNEL_ID=
IAEDU_MODEL_LABEL=GPT-5.5
# Total de tentativas para corrigir JSON truncado/inválido (mínimo 1).
IAEDU_STRUCTURED_MAX_RETRIES=2
# Retries adicionais apenas para rate limits temporários. Retry-After tem prioridade.
IAEDU_RATE_LIMIT_MAX_RETRIES=3
IAEDU_RATE_LIMIT_BASE_DELAY=15
IAEDU_RATE_LIMIT_MAX_DELAY=300
IAEDU_RATE_LIMIT_JITTER=0.2
# Intervalo entre novas configurações A/B no executor resumível.
PILOT_REQUEST_DELAY_SECONDS=60
PROPOSER_LLM_PROVIDER=iaedu
PROPOSER_IAEDU_MODEL_LABEL=GPT-5.5
CRITIC_LLM_PROVIDER=iaedu
CRITIC_IAEDU_MODEL_LABEL=GPT-5.5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
